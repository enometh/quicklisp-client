(in-package "CL-USER")
(defvar *quicklisp-client-source-dir*
  (merge-pathnames "Github/quicklisp-client/" (translate-logical-pathname "EXTERN:")))
(defvar *quicklisp-client-binary-dir* (binary-directory *quicklisp-client-source-dir*))

#+nil ;; use enometh/mk-asdf-shim from codeberg, updates go there
(mk:defsystem :mk-asdf-shim
  :source-pathname *quicklisp-client-source-dir*
  :binary-pathname *quicklisp-client-binary-dir*
  :source-extension "lisp"
  :components ((:module "quicklisp"
		:components(:file "mk-asdf-shim"))))

#+nil
(mk:oos :mk-asdf-shim :load :compile-during-load t)

(mk:defsystem :quicklisp
  :source-pathname *quicklisp-client-source-dir*
  :binary-pathname *quicklisp-client-binary-dir*
  :source-extension "lisp"
  :components ((:file "setup-alt")
	       (:module "quicklisp"
		:components ((:file "package")
			     (:file "utils")
			     (:file "config")
			     (:file "impl")
			     (:file "impl-util")
			     (:file "network")
			     (:file "progress")
			     (:file "http")
			     (:file "deflate")
			     (:file "minitar")
			     (:file "cdb")
			     (:file "dist")
			     (:file "setup")
			     (:file "client")
			     (:file "fetch-gzipped")
			     (:file "client-info")
			     (:file "client-update")
			     (:file "dist-update")
			     (:file "misc")
			     (:file "local-projects")
			     (:file "bundle")))))

#+nil
(mk:oos :quicklisp :load :compile-during-load t)

